# Copy this file to `.env` in this folder (heygen-studio/.env) and fill in each value.
# The real .env is gitignored and NEVER committed — carry it from the old machine or
# paste fresh keys. Rotate any key that was shared in chat.

# HeyGen — video generation (Settings → API)
HEYGEN_API_KEY=

# HubSpot — private app token with crm + files scopes (contacts, lists, file manager)
HUBSPOT_TOKEN=

# logo.dev — PUBLISHABLE key (pk_...), firm logos in thumbnails/emails
LOGODEV_TOKEN=

# Instantly — email dispatch (base64 bearer). Settings → Integrations → API
INSTANTLY_API_KEY=

# HeyReach — LinkedIn dispatch (X-API-KEY header). Settings → API keys
HEYREACH_API_KEY=
