.env
node_modules/
*.mp4
output/
*.cache.json
known-contacts-test-snapshot.json

# ---- Prospect data: NEVER commit. This repo is public. ----
# These hold real names, emails, job titles, companies and LinkedIn URLs for the
# live campaign audience, plus their individual engagement history. They are
# regenerated from HubSpot/Instantly/HeyReach on demand, so nothing is lost by
# keeping them local.
daily-batch-queue*.json
instantly-hubspot-ledger.json
ae-activity-weekly.json
tinyurl-cache.json
tinyurl-clicks*.json
logs/

# Ad-hoc probes and their dumps. Written to answer one question and then kept
# only until the answer lands in a real script. Underscore prefix = throwaway.
#
# Matched by PREFIX, not by extension. The extension list missed a .txt dry-run dump
# holding prospect addresses and email bodies, and this repo is public, so the rule is
# now the convention itself: anything starting with an underscore stays local.
_*

# Super volcano data, rebuilt by super-volcano-rollup.mjs. ~600KB of company records
# including names and owners; published as an artifact file rather than tracked here.
super-volcano.json
