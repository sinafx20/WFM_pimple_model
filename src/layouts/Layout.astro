---
import "../index.css";
import "../styles/shell.css";
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

// Per-contact Open Graph tags so a shared link (LinkedIn DM, Slack, etc.) unfurls
// into a rich card. Server output means LinkedIn's crawler receives these rendered.
// On the intro touchpoint the card is the co-branded video thumbnail (play button
// already burned in) plus the video. Health Check / Calculator / Benchmark / Firms
// Like Yours each get their own purpose-built results card instead (see
// RESULTS_TOOLS below) rather than either falsely implying a video or (for Firms
// Like Yours specifically) fabricating one representative frame when there are
// really several per-vertical testimonials. Demo genuinely does open a video, so
// it uses `demo_thumb` (the same product-frame thumbnail already shown as its
// in-page video cover — was being generated all along but never actually wired to
// the OG tag here, so the shared-link preview didn't match what the page shows).
const sp = Astro.url.searchParams;
const tool = sp.get("tool") || "";
const firstname = (sp.get("firstname") || sp.get("first_name") || "").trim();
const company = (sp.get("company") || sp.get("company_name") || "").trim();
const thumb = (sp.get("thumb") || "").trim();
const demoThumb = (sp.get("demo_thumb") || "").trim();
// Used by the og:video tags below. Do NOT remove: those tags reference it behind an
// `isVideoCard &&` short-circuit, so dropping this line does not fail the build and
// only throws at request time on the exact pages that DO have a video card (intro and
// tp4 with an https thumb) — which is precisely every real TP1 link. That is how it
// broke live on 2026-08-27: the definition was deleted here while the three usages
// stayed, and every intro link served an empty 200 (blank white page) until restored.
const videoUrl = (sp.get("video") || "").trim();
const canonical = Astro.url.href;

const RESULTS_TOOLS = {
  tp1: { title: "Workflow Health Check", desc: "An instant maturity score for your firm, benchmarked against firms your size. About 2 minutes, no sign-up.", param: "health_thumb" },
  tp2: { title: "Profit Leak Calculator", desc: "Put a dollar figure on the gaps in your current workflow. About 2 minutes, no sign-up.", param: "calc_thumb" },
  tp3: { title: "Firm Benchmark", desc: "See how you compare to the industry average and top performers. About 2 minutes, no sign-up.", param: "benchmark_thumb" },
  tp5: { title: "Firms Like Yours", desc: "Video stories from customers across professional services, similar to your own firm.", param: "testimonial_thumb" },
};
const resultsTool = RESULTS_TOOLS[tool];
const resultsThumb = resultsTool ? (sp.get(resultsTool.param) || "").trim() : "";
const isDemo = tool === "tp4";

const ogTitle = tool === "intro"
  ? (firstname ? `A personal video for ${firstname}${company ? ` at ${company}` : ""}` : "A personal message from WorkflowMAX")
  : resultsTool ? resultsTool.title
  : isDemo ? "See WorkflowMAX in action"
  : "WorkflowMAX";
const ogDesc = tool === "intro"
  ? "A 2-minute video, and your own number. Where your firm's margin quietly leaks, and the single biggest gap to close."
  : resultsTool ? resultsTool.desc
  : isDemo ? "A short product walkthrough of the full job lifecycle inside WorkflowMAX. Watch on your own time, no calendar needed."
  : "See where your firm's time and margin quietly leak, with an instant benchmark for firms like yours.";
const ogImage = resultsTool && /^https:\/\//.test(resultsThumb)
  ? resultsThumb
  : isDemo && /^https:\/\//.test(demoThumb)
  ? demoThumb
  : /^https:\/\//.test(thumb) ? thumb : `${base}/WFM-Logo.svg`;
const isVideoCard = (tool === "intro" || isDemo) && /^https:\/\//.test(isDemo ? (demoThumb || thumb) : thumb);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/WFM-Logo.svg`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{ogTitle}</title>
    <meta name="description" content={ogDesc} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={isVideoCard ? "video.other" : "website"} />
    {isVideoCard && videoUrl && <meta property="og:video" content={videoUrl} />}
    {isVideoCard && videoUrl && <meta property="og:video:secure_url" content={videoUrl} />}
    {isVideoCard && videoUrl && <meta property="og:video:type" content="video/mp4" />}
    <meta name="twitter:card" content={isVideoCard ? "player" : "summary_large_image"} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:image" content={ogImage} />
    <!-- HubSpot tracking (portal 24214994). Lives here because the tool pages
         are served by this Astro app, not by Webflow's page renderer, so the
         site-wide Webflow custom code does not reach them. Sets the hubspotutk
         cookie that src/lib/hubspot.js attaches to form submissions. -->
    <script
      type="text/javascript"
      id="hs-script-loader"
      async
      defer
      src="https://js.hs-scripts.com/24214994.js"></script>
    <!-- The tracking script also injects HubSpot "web interactives" (CTA banners),
         which render as a strip pushed above the page. These pages never use
         HubSpot CTAs. HubSpot's injected stylesheet overrides plain CSS with
         higher-specificity !important rules, so a MutationObserver pins inline
         display:none (which nothing can override) on every anchor it creates. -->
    <style>
      html body [id^="hs-web-interactives"] {
        display: none !important;
        height: 0 !important;
        min-height: 0 !important;
      }
    </style>
    <script is:inline>
      (function () {
        var hide = function () {
          document.querySelectorAll('[id^="hs-web-interactives"]').forEach(function (el) {
            el.style.setProperty("display", "none", "important");
            el.style.setProperty("height", "0", "important");
            el.style.setProperty("min-height", "0", "important");
          });
        };
        new MutationObserver(hide).observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener("DOMContentLoaded", hide);
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
