---
import "../index.css";
import "../styles/shell.css";
const base = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/WFM-Logo.svg`} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>WorkflowMAX</title>
    <!-- HubSpot tracking (portal 24214994). Lives here because the tool pages
         are served by this Astro app, not by Webflow's page renderer, so the
         site-wide Webflow custom code does not reach them. Sets the hubspotutk
         cookie that src/lib/hubspot.js attaches to form submissions. -->
    <script
      type="text/javascript"
      id="hs-script-loader"
      async
      defer
      src="https://js.hs-scripts.com/24214994.js"></script>
    <!-- The tracking script also injects HubSpot "web interactives" (CTA banners),
         which render as an empty strip pushed above the page. These pages never
         use HubSpot CTAs, so keep all interactive anchors out of the layout. -->
    <style>
      #hs-web-interactives-top-push-anchor,
      #hs-web-interactives-bottom-push-anchor,
      #hs-web-interactives-top-anchor,
      #hs-web-interactives-bottom-anchor,
      #hs-web-interactives-floating-container {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
